# DigitalOcean Serverless Inference Configuration (OpenAI-compatible endpoint)
DO_INFERENCE_API_KEY=your_digitalocean_model_access_key_here
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DO_INFERENCE_MODEL=llama-4-maverick

# Optional local classifier: disabled by default on Vercel to avoid WASM cold-start delays.
# The hosted vision model still identifies plants without it.
# ENABLE_BIOCLIP=false
